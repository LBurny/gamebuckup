<UserControl x:Class="GameBackup.Plugin.UI.LocateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameBackup.Plugin.UI.Converters"
             FontFamily="{DynamicResource FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameBackup.Plugin;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="查找存档" Style="{StaticResource GB.PageTitle}" />
            <TextBlock Text="{Binding GameName}"
                       Style="{StaticResource GB.Body}"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding InstallDirectory}"
                       Style="{StaticResource GB.Tiny}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding StatusText}"
                       Style="{StaticResource GB.Tiny}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         Height="3"
                         BorderThickness="0"
                         Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Candidates}"
                                  Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GB.Card}" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{StaticResource GB.Body}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Reason}"
                                                       Style="{StaticResource GB.Tiny}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource GB.Pill}">
                                                    <TextBlock Text="{Binding SourceText}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource GB.Pill}">
                                                    <TextBlock Text="{Binding KindText}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource GB.Pill}">
                                                    <TextBlock Text="{Binding ConfidenceText}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource GB.Pill}">
                                                    <TextBlock Text="{Binding ExistsText}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="使用此位置"
                                                Style="{StaticResource GB.PrimaryButton}"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,0">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="{DynamicResource GlyphBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="没有可靠的候选路径"
                                   Style="{StaticResource GB.Body}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="可以让 AI 重试一次，或在下方手动指定存档目录。"
                                   Style="{StaticResource GB.Tiny}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="手动指定"
                               Style="{StaticResource GB.SettingsLabel}"
                               Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             BorderBrush="{DynamicResource PanelSeparatorBrush}" />
                    <Button Grid.Column="2"
                            Content="使用"
                            Style="{StaticResource GB.SecondaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ManualApplyCommand}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="重试"
                            Style="{StaticResource GB.SecondaryButton}"
                            Margin="0,0,8,0"
                            Command="{Binding RetryCommand}" />
                    <Button Content="取消"
                            Style="{StaticResource GB.SecondaryButton}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
