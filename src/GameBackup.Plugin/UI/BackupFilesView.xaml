<UserControl x:Class="GameBackup.Plugin.UI.BackupFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameBackup.Plugin.UI.Converters"
             Background="{DynamicResource WindowBackgourndBrush}"
             FontFamily="{DynamicResource FontFamily}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameBackup.Plugin;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="查找备份" Style="{StaticResource GB.PageTitle}" />
            <TextBlock Text="{Binding GameName}"
                       Style="{StaticResource GB.Body}"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding SavePath}"
                       Style="{StaticResource GB.Tiny}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="备份目录"
                           Style="{StaticResource GB.Tiny}" />
                <TextBlock Text="{Binding BackupRoot}"
                           Style="{StaticResource GB.Tiny}"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Versions}"
                              Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GB.Card}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Directory}"
                                                   Style="{StaticResource GB.Body}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource GB.Pill}">
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource GB.Pill}">
                                                <TextBlock Text="{Binding FileCountText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource GB.Pill}">
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="打开目录"
                                            Style="{StaticResource GB.SecondaryButton}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Command="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center"
                            Margin="0,28,0,0">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="26"
                               Foreground="{DynamicResource GlyphBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="还没有为这款游戏创建备份文件"
                               Style="{StaticResource GB.Body}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="在 GameBackup 页面完成一次备份后，这里会列出每个版本。"
                               Style="{StaticResource GB.Tiny}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开备份目录"
                        Style="{StaticResource GB.SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding OpenRootCommand}" />
                <Button Content="关闭"
                        Style="{StaticResource GB.SecondaryButton}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
